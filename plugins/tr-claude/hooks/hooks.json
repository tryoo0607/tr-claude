{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-runtime.py\" context --product claude",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/product/claude/secret_guard.py\" --event PreToolUse",
            "timeout": 45,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-runtime.py\" upstream --product claude --event PreToolUse",
            "timeout": 8,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|exec_command|write_stdin|Read|read_file|Write|Edit|MultiEdit|Glob|Grep|NotebookEdit|WebFetch|WebSearch|apply_patch|list_mcp_resources|list_mcp_resource_templates|read_mcp_resource|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/product/claude/secret_guard.py\" --event PostToolUse",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-runtime.py\" upstream --product claude --event PostToolUse",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|exec_command|write_stdin|Read|read_file|Write|Edit|MultiEdit|Glob|Grep|NotebookEdit|WebFetch|WebSearch|apply_patch|list_mcp_resources|list_mcp_resource_templates|read_mcp_resource|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/product/claude/secret_guard.py\" --event PostToolUseFailure",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-runtime.py\" upstream --product claude --event PostToolUseFailure",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
